# Copy this to .env.local and fill in values

# API key to protect the question-push endpoint
# Generate with: openssl rand -hex 32
API_KEY=your-secret-key-here

# Vercel KV (Redis) — set automatically when you add KV to your Vercel project
# Leave empty to use in-memory fallback (questions won't persist across deploys)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
